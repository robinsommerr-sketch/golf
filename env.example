# Kopier disse til Environment i Render. Ikke last opp ekte hemmeligheter til GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
JWT_SECRET=GENERER_EN_LANG_TILFELDIG_HEMMELIGHET
# Sett til disable KUN for lokal Postgres uten TLS:
# DATABASE_SSL=disable
# Legg inn dette i Render bare etter at du har funnet din egen numeric user ID:
# OWNER_USER_ID=1
# Alternativt CA-sertifikat til sikker TLS-verifisering:
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
